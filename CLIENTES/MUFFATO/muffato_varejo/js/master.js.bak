function readData2XML(xmlDoc) {
    var data2 = docLoader2.datalist('D_SPD');
    var qtd_itens = xmlDoc.getElementsByTagName('ITEM').length;

    var tipo_product = [1, 2, 3, 4, 5, 6, 7];
    var t0 = [], t1 = [], t2 = [], t3 = [], t4 = [], t5 = [], t6 = [];

    for (var i = 0; i < qtd_itens; i++) {
        var tipo_product_atual = parseInt(data2.get(i).value('TEXT5').value);
        if (tipo_product[0] === tipo_product_atual) {
            t0[i] = i;
        } else if (tipo_product[1] === tipo_product_atual) {
            t1[i] = i;
        } else if (tipo_product[2] === tipo_product_atual) {
            t2[i] = i;
        } else if (tipo_product[3] === tipo_product_atual) {
            t3[i] = i;
        } else if (tipo_product[4] === tipo_product_atual) {
            t4[i] = i;
        } else if (tipo_product[5] === tipo_product_atual) {
            t5[i] = i;
        } else if (tipo_product[6] === tipo_product_atual) {
            t6[i] = i;
        }

    }

    var products = [];
    [t0, t1, t2, t3, t4, t5, t6].forEach(function (t, z) {
        if (t.length !== 0) {
            products.push(t.filter(Number.isFinite));
        }
    });

    console.log(products);

    if (localStorage.getItem(local_storage_type + prox_projeto) >= products.length || localStorage.getItem(local_storage_type + prox_projeto) == null) {
        localStorage.setItem(local_storage_type + prox_projeto, 0);
    }

    prox_tipo = localStorage.getItem(local_storage_type + prox_projeto);
    getproduct(products, data2);

    var ptipo = parseInt(prox_tipo) + 1;
    localStorage.setItem(local_storage_type + prox_projeto, ptipo);

    ebhtml.create2({}, function (loaderConfig) {
        loaderConfig.addData('D_SPD', true, 'f_specialproject=' + special_project[prox_projeto] + '&ft_image_logo=');
        loaderConfig.nodataiserror = false;
        loaderConfig.autoloaded = false;
        loaderConfig.load(function () {
            readConfig(loaderConfig);
        });
    });
}
